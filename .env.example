# ---------------------------------------------------------------------------
# WINNER OS — environment variables
# Copy this file to .env.local and fill in only what you're ready to use.
# The app runs with ZERO of these set — it falls back to demo data + a
# rule-based demo "AI" so it's fully usable out of the box.
# ---------------------------------------------------------------------------

# "demo" (default) generates a realistic, internally-consistent dataset.
# "live" switches to the adapters you implement in lib/data/provider.ts.
DATA_PROVIDER_MODE=demo

# ---- AI provider (optional) ------------------------------------------------
# Leave AI_PROVIDER unset (or set to nothing) to keep every AI feature in
# demo mode. Set one of the blocks below to go live.
AI_PROVIDER=
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# ---- Supabase (optional — required only once you wire up real auth/DB) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Live data integrations (optional, none required to run the demo) -----
META_AD_LIBRARY_ACCESS_TOKEN=
TIKTOK_CREATIVE_CENTER_API_KEY=
GOOGLE_TRENDS_API_KEY=
